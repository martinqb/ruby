<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 6: backups to the user's own Google Drive. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 1: notice when the phone connects to the car. -->
    <!-- Android 12+ asks the user for this one at runtime. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 10 and 11 use the older permission, granted at install. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Phase 2: keep running in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+ asks the user before showing the "Context sensing on" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Phase 3: motion sensing. The step detector needs "Physical activity" (Android 10+). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Keeps the processor awake while moving, so no sensor readings are missed. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Phase 4: GPS to confirm a vehicle and recognize saved places. -->
    <!-- Android asks for approximate and precise together; GPS needs precise. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Optional "Allow all the time", asked for separately. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Voice: hearing the user when they tap Talk. Asked for the first time they do. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Voice: Android 11+ only lets Ruby find the speech recognizer and text-to-speech
         engine if it says it's looking for them. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ruby">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ruby"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hears Bluetooth connects and disconnects, even when Ruby is closed. -->
        <receiver
            android:name=".bluetooth.CarBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- The background service, with its ongoing notification. -->
        <service
            android:name=".sensing.SensingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- Restarts the service after the phone reboots or Ruby is updated. -->
        <receiver
            android:name=".sensing.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>