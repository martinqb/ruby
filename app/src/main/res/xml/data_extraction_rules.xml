<?xml version="1.0" encoding="utf-8"?><!--
   Android's own backup and phone-to-phone transfer (Android 12+).

   Ruby's memory database is left out. It's encrypted with a key wrapped by this phone's
   Keystore, which never leaves the phone, so a copy on another phone couldn't be opened.
   Memory is backed up by Ruby itself instead, to the user's Google Drive, encrypted with
   their passphrase (Phase 6). The key file is in no_backup, which Android never copies.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="memory.db" />
        <exclude domain="database" path="memory.db-wal" />
        <exclude domain="database" path="memory.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="memory.db" />
        <exclude domain="database" path="memory.db-wal" />
        <exclude domain="database" path="memory.db-shm" />
    </device-transfer>
</data-extraction-rules>
