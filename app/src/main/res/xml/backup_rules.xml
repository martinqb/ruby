<?xml version="1.0" encoding="utf-8"?><!--
   Android's own backup (Android 11 and older). See data_extraction_rules.xml for why
   Ruby's memory is left out.
-->
<full-backup-content>
    <exclude domain="database" path="memory.db" />
    <exclude domain="database" path="memory.db-wal" />
    <exclude domain="database" path="memory.db-shm" />
</full-backup-content>
